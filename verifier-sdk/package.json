{
  "name": "@agent-cred/verifier-sdk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run test/revocation.integration.test.ts",
    "test:rate-limit:integration": "vitest run test/rate-limiter.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fastify": "^5.6.2",
    "jose": "^6.1.2",
    "pg": "^8.16.3",
    "redis": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
